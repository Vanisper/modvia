{
  "name": "modvia",
  "version": "0.0.0",
  "description": "A TypeScript bidirectional codec and domain model layer for runtime validation, DTO mapping, and serialization.",
  "keywords": [
    "bidirectional",
    "codec",
    "domain-model",
    "dto",
    "serialization",
    "standard-schema",
    "typescript",
    "validation"
  ],
  "homepage": "https://github.com/Vanisper/modvia#readme",
  "bugs": {
    "url": "https://github.com/Vanisper/modvia/issues"
  },
  "license": "MIT",
  "author": "Vanisper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vanisper/modvia.git",
    "directory": "packages/modvia"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./codec": "./dist/codec.js",
    "./formats": "./dist/formats.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "bench": "vp test bench --run",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
